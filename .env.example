# O Pitch Studio e um app local. Todo valor aqui e opcional: as chaves de API
# normalmente sao salvas pela propria interface (Settings -> API Keys) e ficam
# no SQLite local. Este arquivo existe para o `npm run dev` no navegador.

# ── Geracao simulada (Pitch Studio) ─────────────────────────────────────────
# Sem chave kie.ai, a geracao cai no provider simulado (lib/mockProvider.ts):
# o ciclo do job roda inteiro, so a chamada externa e falsa.
# Coloque false nas duas para desativar e voltar ao erro 401.
MOCK_GENERATION=
NEXT_PUBLIC_MOCK_GENERATION=

# ── Update check (Pitch Studio) ───────────────────────────────────────────
# Repositorio GitHub de releases proprio, ex.: minha-org/pitch-studio.
# Vazio = checagem de atualizacao desligada, sem nenhuma chamada externa.
UPDATE_CHECK_REPO=

# Optional fallback kie.ai key (Settings → API Keys is the normal path).
KIE_API_KEY=

# Optional server-only Higgsfield credentials. Settings → API Keys is the
# normal path. Use the combined SDK format OR the two split values, never
# expose these through NEXT_PUBLIC_* variables.
HF_CREDENTIALS=
# HF_API_KEY_ID=
# HF_API_KEY_SECRET=

# Optional Azure OpenAI key, only if routing GPT Image 2 through Azure AI Foundry.
AZURE_API_KEY=

# Verbose client logging.
NEXT_PUBLIC_DEBUG=
