# SaySell Studio — variáveis de ambiente.
#
# Produção (Vercel): todas as marcadas [prod] são obrigatórias. Sem elas a rota
# responde 503 em vez de cair num adaptador local.
# Desenvolvimento: deixe as [prod] vazias e use STUDIO_DEV_USER; dados vão
# para data/guest.db (SQLite), mídia para public/generated/ e créditos para
# uma carteira falsa em memória.

# ── Sessão e login ─────────────────────────────────────────────────────────
# [prod] HMAC do cookie de sessão, >= 32 caracteres.
STUDIO_SESSION_SECRET=
# [prod] Valores PÚBLICOS do Firebase do SaySell (firebase-applet-config.json
# do saysell-web). O domínio do Studio precisa estar em Authorized domains.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# Dev: entra sem login com este uid (ignorado na Vercel).
STUDIO_DEV_USER=
# Dev: nível da carteira falsa — all (padrão), selected ou none.
STUDIO_DEV_LEVEL=

# ── Dados ──────────────────────────────────────────────────────────────────
# [prod] Conta de serviço do Firebase do SaySell (JSON, base64 ou caminho).
FIREBASE_SERVICE_ACCOUNT=
# [prod] Banco Firestore nomeado do SaySell.
FIREBASE_DATABASE_ID=saysell

# ── Mídia ──────────────────────────────────────────────────────────────────
# [prod] Token do Vercel Blob (a Vercel cria ao ligar o Blob no projeto).
BLOB_READ_WRITE_TOKEN=
# [prod] 1 = arquivo acima de 4 MB vai direto do navegador ao Blob.
NEXT_PUBLIC_STUDIO_DIRECT_UPLOAD=

# ── Créditos (saysell-web) ─────────────────────────────────────────────────
# [prod] Origem do saysell-web, ex.: https://www.saysell.app
SAYSELL_API_URL=
# [prod] O mesmo segredo cadastrado no saysell-web, >= 32 caracteres.
STUDIO_SERVICE_KEY=
# Site para os links "ver planos" e "esqueci a senha".
NEXT_PUBLIC_SAYSELL_SITE_URL=https://www.saysell.app

# ── Provedores ─────────────────────────────────────────────────────────────
# [prod] Chave da kie.ai do SaySell — paga a geração; o usuário paga em créditos.
KIE_API_KEY=
# Sem KIE_API_KEY, fora da Vercel, a geração é simulada. "false" desliga; na
# Vercel só simula com "true" explícito (e não cobra).
MOCK_GENERATION=

# ── Cron ───────────────────────────────────────────────────────────────────
# [prod] A Vercel manda "Authorization: Bearer <CRON_SECRET>" para /api/cron/jobs.
CRON_SECRET=

# ── ffmpeg (opcional) ──────────────────────────────────────────────────────
# Sobrescrevem os binários de ffmpeg-static/ffprobe-static.
FFMPEG_PATH=
FFPROBE_PATH=

# Verbose client logging.
NEXT_PUBLIC_DEBUG=
